# Meeting booking (Google Meet + email)
# Copy to .env and fill in values.

# Google OAuth (Calendar API) — host account that owns the calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Browser Google Sign-In (same Client ID)
VITE_GOOGLE_CLIENT_ID=

# Firebase (leads / contacts / bookings / chat + CMS content)
# Place serviceAccountKey.json in project root (downloaded from Firebase Console)
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
#
# Admin CMS panel (/admin) — Google login allowlist
# ADMIN_EMAILS=ssnexasoft777@gmail.com,shahedroks@gmail.com
# ADMIN_SESSION_SECRET=long-random-string
#
# CMS seed (text + images):
#   npm run seed:cms
# Edit live site content in Firestore (NOT .env) or at /admin:
#   site_settings/main          → brand, SEO, links, chat, nav, footer
#   site_settings/main.links    → whatsappNumber, messengerPage, bookingEmbedUrl,
#                                 githubUrl, linkedinUrl, upworkUrl, fiverrUrl,
#                                 contactEmail, estimatePdfUrl
#   cms_sections/{section}      → hero, about, services, …
#   projects/{slug}             → portfolio items + coverUrl

# Calendly webhook (optional) — POST https://YOUR_DOMAIN/api/webhooks/calendly
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Offline fallbacks only (Firebase site_settings/main.links wins when present)
# VITE_WHATSAPP_NUMBER=8801XXXXXXXXX
# VITE_MESSENGER_PAGE=nexasoft
# VITE_BOOKING_EMBED_URL=https://calendly.com/your-name/30min
# VITE_GITHUB_URL=https://github.com/youruser
# VITE_LINKEDIN_URL=https://www.linkedin.com/in/youruser
# VITE_UPWORK_URL=https://www.upwork.com/freelancers/~yourid
# VITE_FIVERR_URL=https://www.fiverr.com/yourusername
# VITE_CONTACT_EMAIL=mailto:you@gmail.com
# VITE_ESTIMATE_PDF_URL=/project-estimate-guide.pdf

# Host shown on invites / emails
MEETING_HOST_EMAIL=you@gmail.com
MEETING_HOST_NAME=Alex Rivera
MEETING_TIMEZONE=Asia/Dhaka
MEETING_DURATION_MINUTES=30

# Where "Send Message" project briefs are delivered
CONTACT_NOTIFY_EMAIL=you@gmail.com

# Resend — emails the Meet link to the visitor
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meetings <onboarding@resend.dev>

# Stripe (Pricing deposits — Starter / Growth)
# Get keys from https://dashboard.stripe.com/apikeys (use test keys first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_DEPOSIT_STARTER_CENTS=50000
STRIPE_DEPOSIT_GROWTH_CENTS=150000
# Public site URL used for Checkout success/cancel redirects
SITE_URL=http://localhost:8080
