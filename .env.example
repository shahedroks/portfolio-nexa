# Meeting booking (Google Meet + email)
# Copy to .env and fill in values.

# Google OAuth (Calendar API) — host account that owns the calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Browser Google Sign-In (same Client ID)
VITE_GOOGLE_CLIENT_ID=

# Firebase (store Google leads in Firestore)
# Option A (recommended): download service account JSON from Firebase Console
# and place it at project root as serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
#
# Option B: individual env vars
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Marketplace profiles (Hire with confidence section)
# VITE_UPWORK_URL=https://www.upwork.com/freelancers/~yourid
# VITE_FIVERR_URL=https://www.fiverr.com/yourusername

# Optional: override free estimate PDF URL (default: /project-estimate-guide.pdf)
# VITE_ESTIMATE_PDF_URL=/project-estimate-guide.pdf

# Inline booking embed (Calendly event URL or Google Appointment Schedule URL)
# Examples:
#   https://calendly.com/your-name/30min
#   https://calendar.google.com/calendar/appointments/schedules/XXXX?gv=true
VITE_BOOKING_EMBED_URL=

# WhatsApp number with country code, digits only
VITE_WHATSAPP_NUMBER=8801XXXXXXXXX

# Facebook Page username or ID for Messenger (m.me/...)
VITE_MESSENGER_PAGE=nexasoft

# Host shown on invites / emails
MEETING_HOST_EMAIL=you@gmail.com
MEETING_HOST_NAME=Alex Rivera
MEETING_TIMEZONE=Asia/Dhaka
MEETING_DURATION_MINUTES=30

# Where "Send Message" project briefs are delivered
CONTACT_NOTIFY_EMAIL=you@gmail.com

# Resend — emails the Meet link to the visitor
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meetings <onboarding@resend.dev>
